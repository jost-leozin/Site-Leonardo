            align-items: center;
            gap: 8px;
            border: 1px solid var(--border);
            padding: 8px 14px;
            border-radius: 30px;
            color: var(--muted);
            font-size: .85rem;
            margin-bottom: 25px;
        }

        .tag::before {
            content: "";
            width: 7px;
            height: 7px;
            background: var(--accent);
            border-radius: 50%;
        }

        h1 {
            font-family: "Manrope", sans-serif;
